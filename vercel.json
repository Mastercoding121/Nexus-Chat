{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 0; else exit 1; fi",
  "outputDirectory": "dist",
  "functions": {
    "api/admin/**/*.js": {
      "includeFiles": "supabase-schema.sql"
    }
  },
  "routes": [
    { "src": "/api/admin/db-sync", "dest": "/api/admin/db-sync.js" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin/index.cjs" },
    {      "handle": "filesystem"
    },
    {      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
